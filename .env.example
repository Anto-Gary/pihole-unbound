TZ=America/New_York
# The Pi's LAN addresses. It must already own both. Each command below prints only the
# address, for the interface that carries your default route (wlan0 or eth0).
#
# PI_IP, the IPv4 address:
#   ip -4 -o addr show dev "$(ip route show default | awk '{print $5; exit}')" scope global | awk '{print $4}' | cut -d/ -f1
PI_IP=192.168.1.100
#
# PI_IP6, the private IPv6 address (starts with fd). Don't use your public address
# (starts with 2 or 3). If it prints nothing, your router hasn't given the Pi one.
#   ip -6 -o addr show dev "$(ip route show default | awk '{print $5; exit}')" scope global -temporary | awk '{print $4}' | cut -d/ -f1 | grep -i '^fd'
PI_IP6=fd00::1
#
# Admin password for the Pi-hole web UI. install.sh generates a random one if this is
# unset. To choose your own, uncomment it and use only letters and digits (no spaces,
# quotes, # or $). It is the only place the password is stored.
# PIHOLE_PASSWORD=change-me
